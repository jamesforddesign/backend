{
    "name": "nodes/backend",
    "description": "Nodes backend package",
    "keywords": [
        "nodes",
        "backend",
        "manager",
        "administration",
        "admin system",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Morten Rugaard",
            "email": "moru@nodes.dk",
            "role": "Developer"
        }, {
            "name": "Casper Rasmussen",
            "email": "cr@nodes.dk",
            "role": "CTO"
        }, {
            "name": "Dennis Haulund Nielsen",
            "email": "dhni@nodes.dk",
            "role": "Lead Front-end Developer"
        }, {
            "name": "Bo Mouridsen",
            "email": "bomo@nodes.dk",
            "role": "Designer"
        }
    ],
    "require": {
        "composer-plugin-api": "2.*",
        "laravel/framework": "^9.0",
        "laravelcollective/html": "^v6.3.0",
        "nodes/core": "dev-php-8-1",
        "nodes/assets": "dev-php-8-1",
        "nodes/database": "dev-php-8-1",
        "nodes/validation": "dev-php-8-1",
        "nodes/cache": "dev-php-8-1",
        "nodes/bugsnag": "dev-php-8-1",
        "nodes/counter-cache": "dev-php-8-1"
    },
    "autoload": {
        "psr-4": {
           "Nodes\\Backend\\": "src/"
        },
        "files": [
            "src/Support/Helpers/Auth.php",
            "src/Support/Helpers/Router.php",
            "src/Support/Helpers/QueryRestorer.php"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/cache"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/assets"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/nodes-database"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/nodes-validation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/nodes-bugsnag"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jamesforddesign/counter-cache"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    }
}
